{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/user-prompt-submit.cjs\""
      }
    ],
    "afterFileEdit": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/post-tool-lint.cjs\""
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/pre-task-memory.cjs\""
      }
    ],
    "stop": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/stop-lessons.cjs\""
      }
    ]
  }
}
