# Auto detect text files and perform LF normalization
* text=auto

# Force LF for all script files
*.cjs text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Force LF for test fixtures too. These are compared byte-for-byte against string
# constants defined in .cjs files (which are pinned to LF above), so a CRLF checkout
# on Windows makes the comparison fail on line endings alone — a drift failure that
# says nothing about the drift the test exists to catch.
*.txt text eol=lf
