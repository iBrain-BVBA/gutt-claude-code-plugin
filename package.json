{
  "name": "gutt-claude-code-plugin",
  "version": "3.0.0",
  "description": "GUTT Plugin for Claude Code - Memory integration and enhanced tooling",
  "private": true,
  "type": "module",
  "files": [
    "shared",
    "gutt-core",
    "auto-lint-plugin",
    "plugins",
    "docs",
    ".claude-plugin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "test:all": "node --test tests/*.test.cjs && node tests/test-all-hooks.cjs && node tests/check-shared-libs.cjs && node tests/check-state-location.cjs && node tests/check-version-sync.cjs",
    "test:e2e": "node --test tests/e2e/*.e2e.cjs",
    "check:shared": "node tests/check-shared-libs.cjs",
    "check:state": "node tests/check-state-location.cjs",
    "check:version": "node tests/check-version-sync.cjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "docx": "^9.5.3"
  }
}
